kubeconfig
.kube/

# Переменные окружения и другие секреты
.env
.env.*
*.pem
*.key
*.crt

# Файлы операционной системы и редакторов
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Заметки
LONGRID.md
